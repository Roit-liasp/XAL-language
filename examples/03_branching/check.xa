# xalc -o check.xb check.xa
# xvm check.xb 85 6 

fn grade(score) {
    if score >= 90 { return "excellent"; }
    else if score >= 70 { return "good"; }
    else if score >= 50 { return "satisfactory"; }
    else { return "poor"; }
}

fn day_kind(n) {
    case n {
        1, 2, 3, 4, 5 { return "weekday"; }
        6, 7 { return "weekend"; }
        default { return "invalid day"; }
    }
}

fn main() {
    if argc() < 3 {
        print("Usage: " .. argv(0) .. " <score 0-100> <day 1-7>");
        return 1;
    }
    let score = int(argv(1));
    let day = int(argv(2));
    print("Score " .. score .. ": " .. grade(score));
    print("Day " .. day .. ": " .. day_kind(day));
    return 0;
}
